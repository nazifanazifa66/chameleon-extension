{
  "manifest_version": 3,
  "name": "Chameleon Guard",
  "version": "1.0",
  "description": "Automatic AI-based phishing detection and blocking",
  "permissions": ["webNavigation", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html"],
      "matches": ["<all_urls>"]
    }
  ]
}